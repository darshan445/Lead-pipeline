<%= form_with model: agent, class: "space-y-5" do |f| %>
  <% if agent.errors.any? %>
    <div class="rounded-md bg-red-50 px-4 py-3 text-sm text-red-800">
      <%= agent.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Agent name", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, required: true, placeholder: "e.g. Influencer Outreach — US",
          class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 3, placeholder: "What this agent is for — niche, market, goal…",
          class: "w-full rounded-md border-gray-300 shadow-sm text-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :dm_instructions, "Agent instructions for DM pitch (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.rich_text_area :dm_instructions, class: "trix-content rounded-md border-gray-300 text-sm" %>
    <p class="mt-1 text-xs text-gray-400">Used as context for the LLM when generating DM pitches for this agent's leads.</p>
  </div>

  <div>
    <%= f.label :email_instructions, "Agent instructions for email pitch (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.rich_text_area :email_instructions, class: "trix-content rounded-md border-gray-300 text-sm" %>
    <p class="mt-1 text-xs text-gray-400">Used as context for the LLM when generating email pitches for this agent's leads.</p>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    <%= link_to "Cancel", agent.persisted? ? agent_path(agent) : agents_path, class: "text-sm text-gray-500 hover:underline" %>
  </div>
<% end %>
