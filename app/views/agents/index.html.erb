<% content_for :title, "Agents" %>

<div class="mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900 mb-1">Agents</h1>
    <p class="text-sm text-gray-500">Each agent has its own pitch instructions and its own leads.</p>
  </div>
  <%= link_to "New agent", new_agent_path, class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>

<% if @agents.any? %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @agents.each do |agent| %>
      <div class="rounded-lg border border-gray-200 p-4 flex flex-col">
        <h2 class="text-base font-semibold text-gray-900"><%= link_to agent.name, agent_path(agent), class: "hover:underline" %></h2>
        <p class="mt-1 text-sm text-gray-500 line-clamp-3 flex-1"><%= agent.description.presence || "No description" %></p>
        <div class="mt-3 flex items-center justify-between text-sm">
          <span class="text-gray-500"><%= pluralize(agent.leads.count, "lead") %></span>
          <div class="flex gap-3">
            <%= link_to "Open", agent_path(agent), class: "text-indigo-600 hover:underline" %>
            <%= link_to "Edit", edit_agent_path(agent), class: "text-gray-600 hover:underline" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-gray-300 p-12 text-center">
    <h2 class="text-base font-medium text-gray-900 mb-1">Create your first agent</h2>
    <p class="text-sm text-gray-500 mb-4">An agent bundles a name, a description, and pitch instructions. Discovery runs from an agent's page, and every lead it finds belongs to that agent.</p>
    <%= link_to "Create agent", new_agent_path, class: "inline-block rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
  </div>
<% end %>

<div class="mt-6 text-sm">
  <%= link_to "View all leads →", leads_path, class: "text-gray-500 hover:underline" %>
</div>
