# Copy to project root as .env.production:
#   cp docker/env.production.example .env.production
#
# Then:
#   docker compose -f docker-compose.production.yml --env-file .env.production up -d --build
#
# Open: http://YOUR_VULTR_IP/   (plain HTTP, no domain / SSL / nginx needed)

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace_me

POSTGRES_USER=lead_pipeline
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=lead_pipeline_production
POSTGRES_CACHE_DB=lead_pipeline_production_cache
POSTGRES_QUEUE_DB=lead_pipeline_production_queue
POSTGRES_CABLE_DB=lead_pipeline_production_cable

# App on http://YOUR_IP/ (host port 80)
APP_PORT=80

# Plain HTTP by IP — leave these as-is
FORCE_SSL=false
ASSUME_SSL=false
RAILS_ALLOW_ALL_HOSTS=true

# App secrets
APIFY_API_TOKEN=
OPENROUTER_API_KEY=
ANYMAILFINDER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Use your VPS IP (Google Cloud OAuth client → Authorized redirect URIs)
GMAIL_REDIRECT_URI=http://YOUR_VULTR_IP/gmail/oauth/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=darsh@getscotive.com
GMAIL_SENDER_NAME=Darsh Thakor
GMAIL_SEND_DELAY_MIN_MINUTES=8
GMAIL_SEND_DELAY_MAX_MINUTES=13
GMAIL_SEND_TIMEZONE=America/New_York
GMAIL_SEND_WINDOW_START_HOUR=6
GMAIL_SEND_WINDOW_END_HOUR=17

# Solid Queue inside Puma — no separate worker
SOLID_QUEUE_IN_PUMA=true
